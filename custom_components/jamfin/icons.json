      },
      "profile": {
        "default": "mdi:account"
      },
      "media_kind": {
        "default": "mdi:filmstrip",
        "state": {
          "episode": "mdi:television-classic",
          "trailer": "mdi:movie-open-play",
          "preshow": "mdi:popcorn",
          "private": "mdi:eye-off"
        }
      },
      "chapter": {
        "default": "mdi:bookmark-outline"
      },
      "segment": {
        "default": "mdi:debug-step-over"
      },
      "film_colour": {
        "default": "mdi:palette"
      }
    }
  },
  "services": {
    "play_item": {
      "service": "mdi:play"
    },
    "seek": {
      "service": "mdi:fast-forward"
    }
